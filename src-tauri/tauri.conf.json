{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopDashboards",
  "version": "0.3.0",
  "identifier": "works.mowthow.desktopdashboards",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DesktopDashboards",
        "label": "manager",
        "width": 680,
        "height": 560,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../samples/*": "samples/",
      "../connectors/*": "connectors/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"]
      }
    }
  }
}
