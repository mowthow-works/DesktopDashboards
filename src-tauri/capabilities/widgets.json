{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "widgets",
  "description": "Allow widget windows to start dragging and invoke widget_bar_action",
  "windows": ["widget-*"],
  "remote": {
    "urls": ["http://*", "https://*"]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "allow-widget-bar-action",
    "allow-widget-open-new-window"
  ]
}
