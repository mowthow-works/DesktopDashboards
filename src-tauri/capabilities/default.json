{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the manager window",
  "windows": ["manager"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "allow-get-webview-data-dir",
    "allow-get-samples-dir",
    "allow-list-widgets",
    "allow-add-widget",
    "allow-toggle-widget",
    "allow-update-widget-bounds",
    "allow-update-widget-settings",
    "allow-reset-widget-position",
    "allow-delete-widget",
    "allow-reload-widget",
    "allow-reload-all-widgets",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-get-language",
    "allow-set-language",
    "allow-list-connectors",
    "allow-list-connections",
    "allow-save-connection",
    "allow-delete-connection",
    "allow-test-connection",
    "allow-get-widget-config-form",
    "allow-save-widget-config",
    "allow-duplicate-widget"
  ]
}
